# ── Аутентификация (single admin + cookie-сессия) ─────────────
ADMIN_USERNAME=admin
ADMIN_NAME=Администратор
ADMIN_PASSWORD=change-me
AUTH_COOKIE_KEY=set-a-long-random-secret-at-least-32-bytes   # подпись cookie сессии (>=32 байт)
AUTH_COOKIE_NAME=rag_ui_auth
AUTH_COOKIE_EXPIRY_DAYS=7

# ── S3 / MinIO (исходные документы) ───────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documents
S3_REGION=

# ── Сервис обработки (rag_save_pipline) ───────────────────────
PROCESS_URL=http://process:8000/api
PROCESS_API_KEY=change-me

# ── Сервис поиска/ответов (rag_retrive_docs) ──────────────────
# Без этих переменных чат покажет «сервис не подключён», загрузка работает.
RETRIEVAL_URL=http://retrieval:8000/api
RETRIEVAL_API_KEY=change-me

# ── Общее ─────────────────────────────────────────────────────
REQUEST_TIMEOUT=300
