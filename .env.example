# ── Аутентификация (single admin + cookie-сессия) ─────────────
ADMIN_USERNAME=admin
ADMIN_NAME=Администратор
ADMIN_PASSWORD=change-me
# AUTH_COOKIE_KEY — секрет, которым подписывается cookie сессии. Он НЕ
# передаётся в браузер и не связан с API-ключами сервисов: собственный,
# уникальный, длиной >=32 байт (openssl rand -hex 32).
#   • один и тот же ключ на сервере — норма: он должен пережить рестарт
#     контейнера, иначе все входы слетают при каждом деплое;
#   • менять его нужно только при подозрении на утечку — смена разлогинивает
#     всех и даёт «Signature verification failed» на старые cookie;
#   • переиспользовать здесь PROCESS_API_KEY/RETRIEVAL_API_KEY нельзя: те
#     ходят между сервисами и светятся в логах.
AUTH_COOKIE_KEY=                     # openssl rand -hex 32
AUTH_COOKIE_NAME=rag_ui_auth
AUTH_COOKIE_EXPIRY_DAYS=7            # сколько дней живёт вход без повторного логина

# ── S3 (исходные документы; внешний Selectel) ─────────────────
# Бакет и креды обязаны совпадать с бэкендами: фронт заливает файлы, а
# process читает их по тому же s3_key.
S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documents
S3_REGION=ru-1

# ── Сервис обработки (rag_save_pipline) ───────────────────────
# Имя хоста = имя сервиса в docker-сети `rag`, порт ВНУТРЕННИЙ (8000).
# С хоста, вне docker-сети, использовать http://localhost:8000/api
PROCESS_URL=http://process:8000/api
PROCESS_API_KEY=change-me

# ── Сервис поиска/ответов (rag_retrive_docs) ──────────────────
# Внутри сети порт 8000; наружу этот сервис публикуется на 8001,
# поэтому с хоста — http://localhost:8001/api
# Без этих переменных чат покажет «сервис не подключён», загрузка работает.
RETRIEVAL_URL=http://retrieval:8000/api
RETRIEVAL_API_KEY=change-me

# ── Логирование ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Общее ─────────────────────────────────────────────────────
REQUEST_TIMEOUT=300
# История диалогов чата. Каталог примонтирован томом ui_data — менять путь
# нужно только если том монтируется в другое место.
CHAT_HISTORY_FILE=/data/chats.json
